@@ -0,0 +1,19 @@
+#ifndef OPENEC_REFERENCE_LOCAL_POSIX_HH
+#define OPENEC_REFERENCE_LOCAL_POSIX_HH
+#include "UnderFS.hh"
+
+// Isolated functional adapter: a shared POSIX namespace, not an HDFS replica.
+class LocalPosix : public UnderFS {
+ public:
+  LocalPosix(vector<string> params, Config* conf);
+  UnderFile* openFile(string filename, string mode) override;
+  void writeFile(UnderFile*, char*, int) override;
+  void flushFile(UnderFile*) override;
+  void closeFile(UnderFile*) override;
+  int readFile(UnderFile*, char*, int) override;
+  int pReadFile(UnderFile*, int, char*, int) override;
+  int getFileSize(UnderFile*) override;
+ private:
+  string root_;
+};
+#endif
